{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "Preserve",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"types": ["vite/client"],
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["src", "vite.config.ts"]
}
